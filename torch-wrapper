#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

APP_NAME="linux-torch-wrapper"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TORCH_DIR="$SCRIPT_DIR/torch"
TORCH_ZIP_URL="https://build.torchapi.com/job/Torch/job/master/lastSuccessfulBuild/artifact/bin/torch-server.zip"
TORCH_ZIP_PATH="$SCRIPT_DIR/torch-server.zip"
DATA_DIR_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_NAME"
WINEPREFIX_DEFAULT="$SCRIPT_DIR/.wine-torch"
BACKEND_DEFAULT="auto"
BOTTLE_NAME_DEFAULT="Torch"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [--run] [--install-new] [--backend <auto|wine|bottles>] [--bottle <name>] [--wineprefix <path>] [--torch-dir <path>] [--torch-exe <path>] [-- <torch args>]

Options:
  --run                  Check/install dependencies, bootstrap Torch if missing, then run via Wine.
  --install-new          Force download/extract into a new instance directory under <torch-dir>/instances.
  --backend <mode>       Runtime backend: auto, wine, bottles (default: $BACKEND_DEFAULT).
  --bottle <name>        Bottles bottle name when backend is bottles (default: $BOTTLE_NAME_DEFAULT).
  --wineprefix <path>    Wine prefix path (default: $WINEPREFIX_DEFAULT)
  --torch-dir <path>     Torch install directory (default: $TORCH_DIR)
  --torch-exe <path>     Explicit path to Torch executable.
  -h, --help             Show help.

Examples:
  ./$(basename "$0") --run
  ./$(basename "$0") --run -- --help
USAGE
}

log() { printf '[%s] %s\n' "$APP_NAME" "$*"; }
warn() { printf '[%s] warning: %s\n' "$APP_NAME" "$*" >&2; }
err() { printf '[%s] error: %s\n' "$APP_NAME" "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

is_ostree_system() {
  [ -f /run/ostree-booted ] || have rpm-ostree
}

is_bazzite() {
  [ -f /etc/os-release ] && grep -qi '^ID=.*bazzite' /etc/os-release
}

run_privileged() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    "$@"
  elif have sudo; then
    sudo "$@"
  else
    err "Need root or sudo for dependency install: $*"
  fi
}

detect_pm() {
  if have apt-get; then echo apt; return; fi
  if have dnf; then echo dnf; return; fi
  if have yum; then echo yum; return; fi
  if have pacman; then echo pacman; return; fi
  if have zypper; then echo zypper; return; fi
  echo ""
}

detect_bottles_cli() {
  if have bottles-cli; then
    printf '%s\n' "bottles-cli"
    return
  fi

  if have flatpak && flatpak info com.usebottles.bottles >/dev/null 2>&1; then
    printf '%s\n' "flatpak run --command=bottles-cli com.usebottles.bottles"
    return
  fi
}

run_bottles_cli() {
  [ -n "${BOTTLES_CLI_CMD:-}" ] || return 1
  # shellcheck disable=SC2086
  $BOTTLES_CLI_CMD "$@"
}

bottle_path_exists() {
  local native_path="$HOME/.local/share/bottles/bottles/$BOTTLE_NAME"
  local flatpak_path="$HOME/.var/app/com.usebottles.bottles/data/bottles/bottles/$BOTTLE_NAME"
  [ -d "$native_path" ] || [ -d "$flatpak_path" ]
}

ensure_bottle_exists() {
  [ -n "$BOTTLES_CLI_CMD" ] || err "Bottles backend requested but Bottles CLI was not found."

  if run_bottles_cli list bottles 2>/dev/null | grep -Fixq -- "$BOTTLE_NAME"; then
    log "Using existing Bottles bottle: $BOTTLE_NAME"
    return
  fi

  # Some Bottles CLI versions render `list bottles` as a table/JSON-like payload where a strict
  # full-line match is unreliable. Fall back to checking canonical bottle storage paths.
  if bottle_path_exists; then
    log "Using existing Bottles bottle: $BOTTLE_NAME"
    return
  fi

  log "Creating Bottles bottle: $BOTTLE_NAME"
  if run_bottles_cli new --help >/dev/null 2>&1; then
    if run_bottles_cli new -b "$BOTTLE_NAME" -e application >/dev/null 2>&1; then
      return
    fi
    if run_bottles_cli new --bottle-name "$BOTTLE_NAME" --environment application >/dev/null 2>&1; then
      return
    fi
  fi

  err "Unable to auto-create Bottles bottle '$BOTTLE_NAME'.
Please create it in the Bottles app, then rerun:
  $(basename "$0") --run --backend bottles --bottle \"$BOTTLE_NAME\""
}

run_bottle_command() {
  local exe="$1"
  shift
  # Prefer explicit long options for better compatibility with wrappers/older CLI parsers.
  run_bottles_cli run --bottle "$BOTTLE_NAME" --executable "$exe" --args "$*"
}

ensure_bottles_bootstrap_and_tweaks() {
  ensure_bottle_exists

  local bottle_marker_safe
  # Keep '-' at the end of the tr set so it is treated literally (not as a range delimiter).
  bottle_marker_safe="$(printf '%s' "$BOTTLE_NAME" | tr -c '[:alnum:]. _-' '_' | tr ' ' '_')"
  local marker="$SCRIPT_DIR/.torch-wrapper-bottles-${bottle_marker_safe}.done"

  log "Initializing Bottles runtime for $BOTTLE_NAME"
  run_bottle_command "wineboot" "-u" >/dev/null 2>&1 || warn "Failed to run wineboot inside bottle '$BOTTLE_NAME'."

  if [ -f "$marker" ]; then
    log "Bottles bootstrap already completed for bottle: $BOTTLE_NAME"
  else
    log "Bootstrapping Winetricks dependencies in bottle: $BOTTLE_NAME"
    if run_bottle_command "winetricks" "-q corefonts vcrun2022 dotnet48" >/dev/null 2>&1; then
      touch "$marker"
    else
      warn "Could not run winetricks inside bottle '$BOTTLE_NAME'. Install corefonts/vcrun2022/dotnet48 in Bottles if Torch fails to start."
    fi
  fi

  log "Applying Windows version and graphics compatibility tweaks inside bottle: $BOTTLE_NAME"
  run_bottle_command "reg" "add HKCU\\Software\\Wine\\Version /v Version /t REG_SZ /d win10 /f" >/dev/null 2>&1 || warn "Failed to set HKCU\\Software\\Wine\\Version=win10 in bottle."
  run_bottle_command "reg" "add HKCU\\Software\\Wine\\AppDefaults\\steamcmd.exe /v Version /t REG_SZ /d win10 /f" >/dev/null 2>&1 || warn "Failed to set SteamCMD AppDefault win10 override in bottle."
  run_bottle_command "reg" "add HKCU\\Software\\Wine\\Direct3D /v renderer /t REG_SZ /d gdi /f" >/dev/null 2>&1 || warn "Failed to set Direct3D renderer=gdi in bottle."
}

install_linux_dependencies() {
  local pm="$1"
  local missing_deps="$2"

  if is_ostree_system; then
    if is_bazzite; then
      if [ -n "${BOTTLES_CLI_CMD:-}" ]; then
        log "Bazzite detected. Using Bottles backend instead of host Wine dependencies."
        BACKEND="bottles"
        return
      fi
      err "Bazzite uses an immutable rpm-ostree base.
Missing dependencies: ${missing_deps:-unknown}
Install dependencies with:
  rpm-ostree install ${missing_deps:-wine winetricks curl unzip cabextract}
Then reboot and rerun this script.

Or install Bottles and run with:
  $(basename "$0") --run --backend bottles"
    fi
    err "Detected an immutable rpm-ostree system.
Missing dependencies: ${missing_deps:-unknown}
Install dependencies with rpm-ostree, reboot, then rerun this script."
  fi

  log "Installing dependencies with $pm"
  case "$pm" in
    apt)
      run_privileged apt-get update
      run_privileged apt-get install -y wine winetricks curl unzip cabextract
      ;;
    dnf)
      run_privileged dnf install -y wine winetricks curl unzip cabextract
      ;;
    yum)
      run_privileged yum install -y wine winetricks curl unzip cabextract
      ;;
    pacman)
      run_privileged pacman -Sy --noconfirm wine winetricks curl unzip cabextract
      ;;
    zypper)
      run_privileged zypper --non-interactive install wine winetricks curl unzip cabextract
      ;;
    *)
      err "Unsupported package manager. Install wine, winetricks, curl, unzip, cabextract manually."
      ;;
  esac
}

ensure_linux_dependencies() {
  if [ "$BACKEND" = "bottles" ]; then
    [ -n "${BOTTLES_CLI_CMD:-}" ] || err "Bottles backend requested but Bottles CLI was not found."
    return
  fi

  local -a missing_deps=()
  local cmd
  for cmd in wine winetricks curl unzip cabextract; do
    if ! have "$cmd"; then
      missing_deps+=("$cmd")
    fi
  done

  if [ "${#missing_deps[@]}" -gt 0 ]; then
    log "Missing Linux dependencies: ${missing_deps[*]}"
    install_linux_dependencies "$(detect_pm)" "${missing_deps[*]}"
  else
    log "Linux dependencies already installed."
  fi
}

ensure_winetricks_dependencies() {
  export WINEPREFIX="$WINEPREFIX"
  export WINEARCH=win64
  mkdir -p "$WINEPREFIX"

  local marker="$WINEPREFIX/.torch-wrapper-winetricks-done"
  if [ -f "$marker" ]; then
    log "Winetricks bootstrap already completed for this prefix."
    return
  fi

  log "Bootstrapping Winetricks dependencies in $WINEPREFIX"
  winetricks -q corefonts vcrun2022 dotnet48
  touch "$marker"
}

ensure_wine_windows_version() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  log "Setting Wine Windows version override for SteamCMD to Windows 10"
  wine reg add "HKCU\\Software\\Wine\\Version" /v Version /t REG_SZ /d win10 /f >/dev/null
  wine reg add "HKCU\\Software\\Wine\\AppDefaults\\steamcmd.exe" /v Version /t REG_SZ /d win10 /f >/dev/null
}

ensure_wine_graphics_compatibility() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  # Some Wine setups render WinForms/WPF context menus as solid black rectangles.
  # For Torch, forcing Wine's Direct3D renderer to GDI is more stable than OpenGL/Vulkan.
  log "Applying Wine graphics compatibility fix (Direct3D renderer = gdi)"
  wine reg add "HKCU\\Software\\Wine\\Direct3D" /v renderer /t REG_SZ /d gdi /f >/dev/null
}

is_dir_writable() {
  local dir="$1"
  mkdir -p "$dir" 2>/dev/null || return 1

  local probe="$dir/.torch-wrapper-write-test.$$"
  if : >"$probe" 2>/dev/null; then
    rm -f "$probe"
    return 0
  fi

  return 1
}

ensure_torch_storage_writable() {
  local requested_torch_dir="${TORCH_DIR%/}"
  local requested_zip_dir
  requested_zip_dir="$(dirname "$TORCH_ZIP_PATH")"

  if is_dir_writable "$requested_torch_dir" && is_dir_writable "$requested_zip_dir"; then
    return
  fi

  local fallback_root="$DATA_DIR_DEFAULT"
  local fallback_torch_dir="$fallback_root/torch"
  local fallback_zip_path="$fallback_root/torch-server.zip"
  local fallback_instances_dir="$fallback_torch_dir/instances"

  log "Torch directory is not writable: $requested_torch_dir"
  log "Switching Torch storage to user-writable location: $fallback_torch_dir"

  mkdir -p "$fallback_torch_dir" "$fallback_instances_dir"
  if [ -d "$requested_torch_dir" ]; then
    log "Copying existing Torch files to user-writable storage"
    cp -a "$requested_torch_dir/." "$fallback_torch_dir/" 2>/dev/null || warn "Failed to copy some files from $requested_torch_dir to $fallback_torch_dir"
  fi

  TORCH_DIR="$fallback_torch_dir"
  TORCH_ZIP_PATH="$fallback_zip_path"
}

resolve_torch_exe_optional() {
  if [ -n "$TORCH_EXE" ] && [ -f "$TORCH_EXE" ]; then
    printf '%s\n' "$TORCH_EXE"
    return
  fi

  local -a exe_candidates=()
  local candidate
  for candidate in \
    "$TORCH_DIR/Torch.exe" \
    "$TORCH_DIR/torch.exe" \
    "$TORCH_DIR/torch-server.exe" \
    "$TORCH_DIR/Torch.Server.exe"; do
    if [ -f "$candidate" ]; then
      exe_candidates+=("$candidate")
    fi
  done

  if [ -d "$TORCH_DIR" ]; then
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      exe_candidates+=("$candidate")
    done < <(find "$TORCH_DIR" -maxdepth 8 -type f \( -iname 'torch*.exe' -o -iname '*torch*.exe' \) | sort -f)
  fi

  local -A seen=()
  local -a unique_candidates=()
  for candidate in "${exe_candidates[@]}"; do
    if [ -z "${seen[$candidate]+x}" ]; then
      seen["$candidate"]=1
      unique_candidates+=("$candidate")
    fi
  done

  local total="${#unique_candidates[@]}"
  if [ "$total" -eq 0 ]; then
    return
  fi

  if [ "$total" -eq 1 ]; then
    printf '%s\n' "${unique_candidates[0]}"
    return
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    log "Multiple Torch instances detected. Select one to run:"
    local i
    for i in "${!unique_candidates[@]}"; do
      printf '  %d) %s\n' "$((i + 1))" "${unique_candidates[$i]}" >&2
    done

    local choice
    while true; do
      printf 'Enter selection [1-%d]: ' "$total" >&2
      IFS= read -r choice || break
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
        printf '%s\n' "${unique_candidates[$((choice - 1))]}"
        return
      fi
      printf 'Invalid selection. Please choose a number between 1 and %d.\n' "$total" >&2
    done
  fi

  log "Multiple Torch instances detected in non-interactive mode; defaulting to: ${unique_candidates[0]}"
  printf '%s\n' "${unique_candidates[0]}"
}

download_torch() {
  local target_dir="$1"

  log "Downloading latest Torch build from $TORCH_ZIP_URL"
  rm -f "$TORCH_ZIP_PATH"
  curl -fL --retry 3 --retry-delay 2 -o "$TORCH_ZIP_PATH" "$TORCH_ZIP_URL"

  mkdir -p "$target_dir"
  unzip -oq "$TORCH_ZIP_PATH" -d "$target_dir"
  log "Torch extracted to $target_dir"
}

download_torch_if_needed() {
  local exe
  exe="$(resolve_torch_exe_optional || true)"
  if [ "$INSTALL_NEW" -eq 0 ] && [ -n "$exe" ]; then
    log "Detected existing Torch executable at $exe; skipping download."
    return
  fi

  if [ "$INSTALL_NEW" -eq 1 ]; then
    local instance_dir
    instance_dir="$TORCH_DIR/instances/torch-$(date +%Y%m%d-%H%M%S)"
    download_torch "$instance_dir"
    TORCH_EXE="$(resolve_torch_exe_optional || true)"
    [ -n "$TORCH_EXE" ] || err "Torch download completed but no executable was found in $instance_dir"
    return
  fi

  download_torch "$TORCH_DIR"
}

resolve_torch_exe_required() {
  local exe
  exe="$(resolve_torch_exe_optional || true)"
  [ -n "$exe" ] || err "Unable to locate Torch executable in $TORCH_DIR"
  printf '%s\n' "$exe"
}

run_torch() {
  local exe
  exe="$(resolve_torch_exe_required)"

  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  log "Launching Torch via Wine: $exe"
  wine "$exe" "$@"
}

run_torch_with_bottles() {
  local exe
  exe="$(resolve_torch_exe_required)"

  ensure_bottles_bootstrap_and_tweaks
  log "Launching Torch via Bottles (bottle=$BOTTLE_NAME): $exe"
  if run_bottles_cli run --help >/dev/null 2>&1; then
    run_bottle_command "$exe" "$*"
    return
  fi

  err "This Bottles CLI version does not support the 'run' command.
Please run Torch from the Bottles UI using bottle '$BOTTLE_NAME'."
}

RUN=0
INSTALL_NEW=0
WINEPREFIX="$WINEPREFIX_DEFAULT"
TORCH_EXE=""
TORCH_ARGS=()
BACKEND="$BACKEND_DEFAULT"
BOTTLE_NAME="$BOTTLE_NAME_DEFAULT"
BOTTLES_CLI_CMD="$(detect_bottles_cli || true)"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --run)
      RUN=1
      shift
      ;;
    --install-new)
      INSTALL_NEW=1
      shift
      ;;
    --backend)
      shift
      [ "$#" -gt 0 ] || err "--backend requires a value (auto|wine|bottles)"
      case "$1" in
        auto|wine|bottles) BACKEND="$1" ;;
        *) err "Invalid --backend value: $1 (expected auto|wine|bottles)" ;;
      esac
      shift
      ;;
    --bottle)
      shift
      [ "$#" -gt 0 ] || err "--bottle requires a name"
      BOTTLE_NAME="$1"
      shift
      ;;
    --wineprefix)
      shift
      [ "$#" -gt 0 ] || err "--wineprefix requires a path"
      WINEPREFIX="$1"
      shift
      ;;
    --torch-dir)
      shift
      [ "$#" -gt 0 ] || err "--torch-dir requires a path"
      TORCH_DIR="$1"
      shift
      ;;
    --torch-exe)
      shift
      [ "$#" -gt 0 ] || err "--torch-exe requires a path"
      TORCH_EXE="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      TORCH_ARGS=("$@")
      break
      ;;
    *)
      err "Unknown option: $1"
      ;;
  esac
done

if [ "$RUN" -ne 1 ]; then
  usage
  exit 1
fi

if [ "$BACKEND" = "auto" ]; then
  if is_bazzite && [ -n "$BOTTLES_CLI_CMD" ]; then
    BACKEND="bottles"
  else
    BACKEND="wine"
  fi
fi

ensure_linux_dependencies
ensure_torch_storage_writable
download_torch_if_needed
if [ "$BACKEND" = "bottles" ]; then
  run_torch_with_bottles "${TORCH_ARGS[@]}"
else
  ensure_winetricks_dependencies
  ensure_wine_windows_version
  ensure_wine_graphics_compatibility
  run_torch "${TORCH_ARGS[@]}"
fi
