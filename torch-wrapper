#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

APP_NAME="linux-torch-wrapper"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TORCH_DIR="$SCRIPT_DIR/torch"
INSTANCES_DIR="$SCRIPT_DIR/instances"
TORCH_ZIP_URL="https://build.torchapi.com/job/Torch/job/master/lastSuccessfulBuild/artifact/bin/torch-server.zip"
TORCH_ZIP_PATH="$SCRIPT_DIR/torch-server.zip"
DATA_DIR_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_NAME"
WINEPREFIX_DEFAULT="$SCRIPT_DIR/.wine-torch"
BACKEND_DEFAULT="auto"
DISTROBOX_NAME_DEFAULT="torch-wrapper"
DISTROBOX_IMAGE_DEFAULT="docker.io/library/debian:stable-slim"
BACKEND_SET_BY_ARG=0
IN_DISTROBOX_MARKER="${TORCH_WRAPPER_INSIDE_DISTROBOX:-0}"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [--run] [--install-new] [--backend <auto|wine|distrobox>] [--distrobox-name <name>] [--distrobox-image <image>] [--wineprefix <path>] [--torch-dir <path>] [--instances-dir <path>] [--torch-exe <path>] [-- <torch args>]

Options:
  --run                    Check/install dependencies, bootstrap Torch if missing, then run.
  --install-new            Force install into a newly prompted folder under <instances-dir> (default: $INSTANCES_DIR).
  --backend <mode>         Runtime backend: auto, wine, distrobox (default: $BACKEND_DEFAULT).
  --distrobox-name <name>  Distrobox container name when backend is distrobox (default: $DISTROBOX_NAME_DEFAULT).
  --distrobox-image <img>  Distrobox image for first-time container creation (default: $DISTROBOX_IMAGE_DEFAULT).
  --wineprefix <path>      Wine prefix path (default: $WINEPREFIX_DEFAULT)
  --torch-dir <path>       Torch install directory for direct executable discovery (default: $TORCH_DIR)
  --instances-dir <path>   Override Torch instances directory (default: $INSTANCES_DIR)
  --torch-exe <path>       Explicit path to Torch executable.
  -h, --help               Show help.

Examples:
  ./$(basename "$0") --run
  ./$(basename "$0") --run --backend distrobox
  ./$(basename "$0") --run -- --help
USAGE
}

log() { printf '[%s] %s\n' "$APP_NAME" "$*" >&2; }
warn() { printf '[%s] warning: %s\n' "$APP_NAME" "$*" >&2; }
err() { printf '[%s] error: %s\n' "$APP_NAME" "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

is_ostree_system() {
  [ -f /run/ostree-booted ] || have rpm-ostree
}

run_privileged() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    "$@"
  elif have sudo; then
    sudo "$@"
  else
    err "Need root or sudo for dependency install: $*"
  fi
}

detect_pm() {
  if have apt-get; then echo apt; return; fi
  if have dnf; then echo dnf; return; fi
  if have yum; then echo yum; return; fi
  if have pacman; then echo pacman; return; fi
  if have zypper; then echo zypper; return; fi
  echo ""
}

distrobox_exists() {
  have distrobox || return 1
  distrobox list --no-color 2>/dev/null | awk 'NR>1 {print $1}' | grep -Fixq -- "$DISTROBOX_NAME"
}

required_distrobox_mount_paths() {
  local -A seen=()
  local -a paths=()
  local path
  for path in \
    "$SCRIPT_DIR" \
    "${TORCH_DIR%/}" \
    "${INSTANCES_DIR%/}" \
    "$(dirname "$TORCH_ZIP_PATH")" \
    "${WINEPREFIX%/}"; do
    [ -n "$path" ] || continue
    if [ -z "${seen[$path]+x}" ]; then
      seen["$path"]=1
      paths+=("$path")
    fi
  done
  printf '%s\n' "${paths[@]}"
}

verify_distrobox_mount_paths() {
  local path probe probe_q
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    mkdir -p "$path"
    probe="$path/.torch-wrapper-mount-check.$$"
    : > "$probe"
    probe_q="$(printf '%q' "$probe")"
    if ! run_distrobox "[ -f $probe_q ]"; then
      rm -f "$probe"
      err "Distrobox container '$DISTROBOX_NAME' is missing required mount path: $path. Recreate it (e.g. 'distrobox rm $DISTROBOX_NAME') and rerun."
    fi
    rm -f "$probe"
  done < <(required_distrobox_mount_paths)
}

ensure_distrobox_exists() {
  if [ "$IN_DISTROBOX_MARKER" = "1" ]; then
    return
  fi

  have distrobox || err "Distrobox backend requested but 'distrobox' was not found. Install distrobox and rerun."

  if distrobox_exists; then
    log "Using existing Distrobox container: $DISTROBOX_NAME"
    if ! distrobox enter "$DISTROBOX_NAME" -- true >/dev/null 2>&1; then
      err "Unable to enter existing Distrobox container '$DISTROBOX_NAME'. Recreate it (e.g. 'distrobox rm $DISTROBOX_NAME') and rerun."
    fi
    verify_distrobox_mount_paths
    return
  fi

  log "Creating Distrobox container: $DISTROBOX_NAME (image: $DISTROBOX_IMAGE)"
  local -a volume_paths=()
  local path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    volume_paths+=("$path")
  done < <(required_distrobox_mount_paths)

  local -a volume_args=()
  for path in "${volume_paths[@]}"; do
    mkdir -p "$path"
    volume_args+=(--volume "$path:$path:rw")
  done

  distrobox create --yes --name "$DISTROBOX_NAME" --image "$DISTROBOX_IMAGE" "${volume_args[@]}"
  if ! distrobox enter "$DISTROBOX_NAME" -- true >/dev/null 2>&1; then
    err "Created Distrobox container '$DISTROBOX_NAME' but failed to enter it. Check your Distrobox/Podman setup and rerun."
  fi
  verify_distrobox_mount_paths
}

prompt_backend_selection() {
  if [ "$BACKEND_SET_BY_ARG" -eq 1 ] && [ "$BACKEND" != "auto" ]; then
    return
  fi

  if [ "$BACKEND" != "auto" ]; then
    return
  fi

  if is_ostree_system; then
    BACKEND="distrobox"
    log "Detected immutable rpm-ostree system. Defaulting backend to Distrobox."
    return
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    log "Select installation mode:"
    printf '  1) Install dependencies and run directly on host system (Wine)\n' >&2
    printf '  2) Install and run fully inside Distrobox container\n' >&2

    local choice
    while true; do
      printf 'Enter selection [1-2] (default: 2): ' >&2
      IFS= read -r choice || break
      case "${choice:-2}" in
        1)
          BACKEND="wine"
          return
          ;;
        2)
          BACKEND="distrobox"
          return
          ;;
      esac
      printf 'Invalid selection. Please enter 1 or 2.\n' >&2
    done
  fi

  BACKEND="wine"
  log "Non-interactive mode: defaulting backend to direct host Wine."
}

run_distrobox() {
  local cmd="$1"
  if [ "$IN_DISTROBOX_MARKER" = "1" ]; then
    bash -lc "$cmd"
    return
  fi

  distrobox enter "$DISTROBOX_NAME" -- bash -lc "$cmd"
}

reexec_inside_distrobox_if_needed() {
  [ "$BACKEND" = "distrobox" ] || return
  [ "$IN_DISTROBOX_MARKER" != "1" ] || return

  ensure_distrobox_exists

  local -a cmd=("$SCRIPT_DIR/torch-wrapper")
  local arg
  for arg in "${ORIGINAL_ARGS[@]}"; do
    cmd+=("$arg")
  done

  log "Entering Distrobox container '$DISTROBOX_NAME' and continuing execution there."
  distrobox enter "$DISTROBOX_NAME" -- env TORCH_WRAPPER_INSIDE_DISTROBOX=1 "${cmd[@]}"
}

ensure_distrobox_dependencies() {
  ensure_distrobox_exists

  log "Ensuring runtime dependencies exist inside Distrobox container"
  run_distrobox '
set -euo pipefail
missing=()
for cmd in wine winetricks curl unzip cabextract; do
  command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
if [ "${#missing[@]}" -eq 0 ]; then
  exit 0
fi

if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y wine winetricks curl unzip cabextract
elif command -v dnf >/dev/null 2>&1; then
  sudo dnf install -y wine winetricks curl unzip cabextract
elif command -v yum >/dev/null 2>&1; then
  sudo yum install -y wine winetricks curl unzip cabextract
elif command -v pacman >/dev/null 2>&1; then
  sudo pacman -Sy --noconfirm wine winetricks curl unzip cabextract
elif command -v zypper >/dev/null 2>&1; then
  sudo zypper --non-interactive install wine winetricks curl unzip cabextract
else
  echo "Unsupported package manager in container; install manually: ${missing[*]}" >&2
  exit 1
fi
'
}

install_linux_dependencies() {
  local pm="$1"

  if is_ostree_system; then
    log "Detected immutable rpm-ostree system. Switching backend to Distrobox."
    BACKEND="distrobox"
    return
  fi

  log "Installing dependencies with $pm"
  case "$pm" in
    apt)
      run_privileged apt-get update
      run_privileged apt-get install -y wine winetricks curl unzip cabextract
      ;;
    dnf)
      run_privileged dnf install -y wine winetricks curl unzip cabextract
      ;;
    yum)
      run_privileged yum install -y wine winetricks curl unzip cabextract
      ;;
    pacman)
      run_privileged pacman -Sy --noconfirm wine winetricks curl unzip cabextract
      ;;
    zypper)
      run_privileged zypper --non-interactive install wine winetricks curl unzip cabextract
      ;;
    *)
      err "Unsupported package manager. Install wine, winetricks, curl, unzip, cabextract manually."
      ;;
  esac
}

ensure_linux_dependencies() {
  if [ "$BACKEND" = "distrobox" ]; then
    ensure_distrobox_dependencies
    return
  fi

  local -a missing_deps=()
  local cmd
  for cmd in wine winetricks curl unzip cabextract; do
    if ! have "$cmd"; then
      missing_deps+=("$cmd")
    fi
  done

  if [ "${#missing_deps[@]}" -gt 0 ]; then
    log "Missing Linux dependencies: ${missing_deps[*]}"
    install_linux_dependencies "$(detect_pm)"
    if [ "$BACKEND" = "distrobox" ]; then
      ensure_distrobox_dependencies
    fi
  else
    log "Linux dependencies already installed."
  fi
}

ensure_winetricks_dependencies() {
  export WINEPREFIX="$WINEPREFIX"
  export WINEARCH=win64
  mkdir -p "$WINEPREFIX"

  local marker="$WINEPREFIX/.torch-wrapper-winetricks-done"
  if [ -f "$marker" ]; then
    log "Winetricks bootstrap already completed for this prefix."
    return
  fi

  log "Bootstrapping Winetricks dependencies in $WINEPREFIX"
  winetricks -q corefonts vcrun2022 dotnet48
  touch "$marker"
}

ensure_wine_windows_version() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  log "Setting Wine Windows version override for SteamCMD to Windows 10"
  wine reg add "HKCU\\Software\\Wine\\Version" /v Version /t REG_SZ /d win10 /f >/dev/null
  wine reg add "HKCU\\Software\\Wine\\AppDefaults\\steamcmd.exe" /v Version /t REG_SZ /d win10 /f >/dev/null
}

ensure_wine_graphics_compatibility() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  # Some Wine setups render WinForms/WPF context menus as solid black rectangles.
  # For Torch, forcing Wine's Direct3D renderer to GDI is more stable than OpenGL/Vulkan.
  log "Applying Wine graphics compatibility fix (Direct3D renderer = gdi)"
  wine reg add "HKCU\\Software\\Wine\\Direct3D" /v renderer /t REG_SZ /d gdi /f >/dev/null
}

ensure_distrobox_winetricks_and_tweaks() {
  local marker="$WINEPREFIX/.torch-wrapper-winetricks-done"
  local wineprefix_q
  wineprefix_q="$(printf '%q' "$WINEPREFIX")"

  run_distrobox "
set -euo pipefail
export WINEPREFIX=$wineprefix_q
export WINEARCH=win64
mkdir -p \"\$WINEPREFIX\"

if [ ! -f \"$marker\" ]; then
  winetricks -q corefonts vcrun2022 dotnet48
  touch \"$marker\"
fi

wine reg add 'HKCU\\Software\\Wine\\Version' /v Version /t REG_SZ /d win10 /f >/dev/null
wine reg add 'HKCU\\Software\\Wine\\AppDefaults\\steamcmd.exe' /v Version /t REG_SZ /d win10 /f >/dev/null
wine reg add 'HKCU\\Software\\Wine\\Direct3D' /v renderer /t REG_SZ /d gdi /f >/dev/null
"
}

create_host_launcher() {
  local exe="$1"
  local bindir="$HOME/.local/bin"
  local launcher="$bindir/torch-distrobox"

  mkdir -p "$bindir"
  cat > "$launcher" <<LAUNCHER
#!/usr/bin/env bash
set -euo pipefail
exec "$(printf '%q' "$SCRIPT_DIR/torch-wrapper")" --run --backend distrobox --distrobox-name "$(printf '%q' "$DISTROBOX_NAME")" --wineprefix "$(printf '%q' "$WINEPREFIX")" --torch-exe "$(printf '%q' "$exe")" -- "\$@"
LAUNCHER
  chmod +x "$launcher"
  log "Host launcher updated: $launcher"
}

is_dir_writable() {
  local dir="$1"
  mkdir -p "$dir" 2>/dev/null || return 1

  local probe="$dir/.torch-wrapper-write-test.$$"
  if : >"$probe" 2>/dev/null; then
    rm -f "$probe"
    return 0
  fi

  return 1
}

instance_default_name() {
  printf 'torch-%s\n' "$(date +%Y%m%d-%H%M%S)"
}

sanitize_instance_name() {
  local name="$1"
  name="${name//\//-}"
  name="${name//\\/-}"
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  [ -n "$name" ] || name="$(instance_default_name)"
  printf '%s\n' "$name"
}

instances_dir_path() {
  printf '%s\n' "${INSTANCES_DIR%/}"
}

normalize_path_value() {
  local raw="${1-}"
  local line normalized=""
  while IFS= read -r line; do
    line="${line%$'\r'}"
    [ -n "${line//[[:space:]]/}" ] || continue
    normalized="$line"
  done <<<"$raw"

  normalized="${normalized#\"}"
  normalized="${normalized%\"}"
  printf '%s\n' "$normalized"
}

ensure_instances_dir() {
  local instances_dir
  instances_dir="$(instances_dir_path)"
  mkdir -p "$instances_dir"
}

find_torch_exe_in_dir_optional() {
  local root="$1"
  [ -d "$root" ] || return

  local -a exe_candidates=()
  local candidate
  for candidate in \
    "$root/Torch.exe" \
    "$root/torch.exe" \
    "$root/torch-server.exe" \
    "$root/Torch.Server.exe"; do
    if [ -f "$candidate" ]; then
      exe_candidates+=("$candidate")
    fi
  done

  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    exe_candidates+=("$candidate")
  done < <(find "$root" -maxdepth 8 -type f \( -iname 'torch*.exe' -o -iname '*torch*.exe' \) | sort -f)

  local -A seen=()
  local -a unique_candidates=()
  for candidate in "${exe_candidates[@]}"; do
    if [ -z "${seen[$candidate]+x}" ]; then
      seen["$candidate"]=1
      unique_candidates+=("$candidate")
    fi
  done

  [ "${#unique_candidates[@]}" -gt 0 ] || return
  printf '%s\n' "${unique_candidates[0]}"
}

choose_new_instance_dir() {
  local instances_dir default_name input_name chosen_name target_dir
  instances_dir="$(instances_dir_path)"
  default_name="$(instance_default_name)"
  input_name=""

  if [ -t 0 ] && [ -t 1 ]; then
    printf 'Enter Torch instance folder name [%s]: ' "$default_name" >&2
    IFS= read -r input_name || true
  fi

  if [ -z "${input_name:-}" ]; then
    chosen_name="$default_name"
  else
    chosen_name="$(sanitize_instance_name "$input_name")"
  fi

  target_dir="$instances_dir/$chosen_name"
  mkdir -p "$target_dir"
  printf '%s\n' "$target_dir"
}

select_existing_or_new_instance_dir() {
  local instances_dir
  instances_dir="$(instances_dir_path)"

  local -a folders=()
  local entry
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    folders+=("$entry")
  done < <(find "$instances_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -f)

  if [ "${#folders[@]}" -eq 0 ]; then
    choose_new_instance_dir
    return
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    log "Select Torch instance folder:"
    local i total choice
    total="${#folders[@]}"
    for i in "${!folders[@]}"; do
      printf '  %d) %s\n' "$((i + 1))" "${folders[$i]}" >&2
    done
    printf '  %d) %s\n' "$((total + 1))" "Create new instance folder" >&2

    while true; do
      printf 'Enter selection [1-%d]: ' "$((total + 1))" >&2
      IFS= read -r choice || break
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
        printf '%s/%s\n' "$instances_dir" "${folders[$((choice - 1))]}"
        return
      fi
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq $((total + 1)) ]; then
        choose_new_instance_dir
        return
      fi
      printf 'Invalid selection. Please choose a number between 1 and %d.\n' "$((total + 1))" >&2
    done
  fi

  log "Non-interactive mode: using first instance folder: ${folders[0]}"
  printf '%s/%s\n' "$instances_dir" "${folders[0]}"
}

ensure_torch_storage_writable() {
  local requested_torch_dir="${TORCH_DIR%/}"
  local requested_instances_dir="${INSTANCES_DIR%/}"
  local requested_zip_dir
  requested_zip_dir="$(dirname "$TORCH_ZIP_PATH")"

  if is_dir_writable "$requested_torch_dir" && is_dir_writable "$requested_instances_dir" && is_dir_writable "$requested_zip_dir"; then
    mkdir -p "$requested_torch_dir" "$requested_instances_dir"
    return
  fi

  local fallback_root="$DATA_DIR_DEFAULT"
  local fallback_torch_dir="$fallback_root/torch"
  local fallback_zip_path="$fallback_root/torch-server.zip"
  local fallback_instances_dir="$fallback_root/instances"

  if ! is_dir_writable "$requested_torch_dir"; then
    log "Torch directory is not writable: $requested_torch_dir"
  fi
  if ! is_dir_writable "$requested_instances_dir"; then
    log "Instances directory is not writable: $requested_instances_dir"
  fi
  if ! is_dir_writable "$requested_zip_dir"; then
    log "Download directory is not writable: $requested_zip_dir"
  fi
  log "Switching Torch storage to user-writable location: torch=$fallback_torch_dir instances=$fallback_instances_dir"

  mkdir -p "$fallback_torch_dir" "$fallback_instances_dir"
  if [ -d "$requested_torch_dir" ]; then
    log "Copying existing Torch files to user-writable storage"
    cp -a "$requested_torch_dir/." "$fallback_torch_dir/" 2>/dev/null || warn "Failed to copy some files from $requested_torch_dir to $fallback_torch_dir"
  fi

  TORCH_DIR="$fallback_torch_dir"
  INSTANCES_DIR="$fallback_instances_dir"
  TORCH_ZIP_PATH="$fallback_zip_path"
}

resolve_torch_exe_optional() {
  local normalized_torch_exe
  normalized_torch_exe="$(normalize_path_value "${TORCH_EXE-}")"
  if [ -n "$normalized_torch_exe" ] && [ -f "$normalized_torch_exe" ]; then
    TORCH_EXE="$normalized_torch_exe"
    printf '%s\n' "$TORCH_EXE"
    return
  fi

  local -a exe_candidates=()
  local candidate
  for candidate in \
    "$TORCH_DIR/Torch.exe" \
    "$TORCH_DIR/torch.exe" \
    "$TORCH_DIR/torch-server.exe" \
    "$TORCH_DIR/Torch.Server.exe"; do
    if [ -f "$candidate" ]; then
      exe_candidates+=("$candidate")
    fi
  done

  if [ -d "$TORCH_DIR" ]; then
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      exe_candidates+=("$candidate")
    done < <(find "$TORCH_DIR" -maxdepth 8 -type f \( -iname 'torch*.exe' -o -iname '*torch*.exe' \) | sort -f)
  fi

  local -A seen=()
  local -a unique_candidates=()
  for candidate in "${exe_candidates[@]}"; do
    if [ -z "${seen[$candidate]+x}" ]; then
      seen["$candidate"]=1
      unique_candidates+=("$candidate")
    fi
  done

  local total="${#unique_candidates[@]}"
  if [ "$total" -eq 0 ]; then
    return
  fi

  if [ "$total" -eq 1 ]; then
    printf '%s\n' "${unique_candidates[0]}"
    return
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    log "Multiple Torch instances detected. Select one to run:"
    local i
    for i in "${!unique_candidates[@]}"; do
      printf '  %d) %s\n' "$((i + 1))" "${unique_candidates[$i]}" >&2
    done

    local choice
    while true; do
      printf 'Enter selection [1-%d]: ' "$total" >&2
      IFS= read -r choice || break
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
        printf '%s\n' "${unique_candidates[$((choice - 1))]}"
        return
      fi
      printf 'Invalid selection. Please choose a number between 1 and %d.\n' "$total" >&2
    done
  fi

  log "Multiple Torch instances detected in non-interactive mode; defaulting to: ${unique_candidates[0]}"
  printf '%s\n' "${unique_candidates[0]}"
}

download_torch() {
  local target_dir="$1"

  log "Downloading latest Torch build from $TORCH_ZIP_URL"
  if [ "$BACKEND" = "distrobox" ]; then
    local zip_q target_q url_q
    zip_q="$(printf '%q' "$TORCH_ZIP_PATH")"
    target_q="$(printf '%q' "$target_dir")"
    url_q="$(printf '%q' "$TORCH_ZIP_URL")"
    run_distrobox "rm -f $zip_q; curl -fL --retry 3 --retry-delay 2 -o $zip_q $url_q; mkdir -p $target_q; unzip -oq $zip_q -d $target_q"
  else
    rm -f "$TORCH_ZIP_PATH"
    curl -fL --retry 3 --retry-delay 2 -o "$TORCH_ZIP_PATH" "$TORCH_ZIP_URL"
    mkdir -p "$target_dir"
    unzip -oq "$TORCH_ZIP_PATH" -d "$target_dir"
  fi
  log "Torch extracted to $target_dir"
}

download_torch_if_needed() {
  ensure_instances_dir

  local selected_instance_dir selected_exe
  selected_instance_dir="$(normalize_path_value "$(select_existing_or_new_instance_dir)")"

  if [ "$INSTALL_NEW" -eq 0 ]; then
    selected_exe="$(normalize_path_value "$(find_torch_exe_in_dir_optional "$selected_instance_dir" || true)")"
    if [ -n "$selected_exe" ]; then
      TORCH_EXE="$selected_exe"
      log "Detected existing Torch executable at $selected_exe; skipping download."
      return
    fi
  fi

  if [ "$INSTALL_NEW" -eq 1 ]; then
    selected_instance_dir="$(normalize_path_value "$(choose_new_instance_dir)")"
  fi

  download_torch "$selected_instance_dir"
  TORCH_EXE="$(normalize_path_value "$(find_torch_exe_in_dir_optional "$selected_instance_dir" || true)")"
  [ -n "$TORCH_EXE" ] || err "Torch download completed but no executable was found in $selected_instance_dir"
}

resolve_torch_exe_required() {
  local exe
  exe="$(resolve_torch_exe_optional || true)"
  [ -n "$exe" ] || err "Unable to locate Torch executable in $TORCH_DIR"
  printf '%s\n' "$exe"
}

run_torch_with_wine() {
  local exe
  exe="$(resolve_torch_exe_required)"

  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  log "Launching Torch via Wine: $exe"
  wine "$exe" "$@"
}

run_torch_with_distrobox() {
  local exe
  exe="$(resolve_torch_exe_required)"

  ensure_distrobox_winetricks_and_tweaks
  create_host_launcher "$exe"

  local wineprefix_q exe_q args_q
  wineprefix_q="$(printf '%q' "$WINEPREFIX")"
  exe_q="$(printf '%q' "$exe")"
  args_q="$(printf ' %q' "$@")"

  log "Launching Torch via Distrobox container '$DISTROBOX_NAME': $exe"
  run_distrobox "export WINEPREFIX=$wineprefix_q; wine $exe_q$args_q"
}

RUN=0
INSTALL_NEW=0
WINEPREFIX="$WINEPREFIX_DEFAULT"
TORCH_EXE=""
TORCH_ARGS=()
ORIGINAL_ARGS=("$@")
BACKEND="$BACKEND_DEFAULT"
DISTROBOX_NAME="$DISTROBOX_NAME_DEFAULT"
DISTROBOX_IMAGE="$DISTROBOX_IMAGE_DEFAULT"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --run)
      RUN=1
      shift
      ;;
    --install-new)
      INSTALL_NEW=1
      shift
      ;;
    --backend)
      shift
      [ "$#" -gt 0 ] || err "--backend requires a value (auto|wine|distrobox)"
      case "$1" in
        auto|wine|distrobox) BACKEND="$1" ;;
        *) err "Invalid --backend value: $1 (expected auto|wine|distrobox)" ;;
      esac
      if [ "$BACKEND" != "auto" ]; then
        BACKEND_SET_BY_ARG=1
      fi
      shift
      ;;
    --distrobox-name)
      shift
      [ "$#" -gt 0 ] || err "--distrobox-name requires a value"
      DISTROBOX_NAME="$1"
      shift
      ;;
    --distrobox-image)
      shift
      [ "$#" -gt 0 ] || err "--distrobox-image requires a value"
      DISTROBOX_IMAGE="$1"
      shift
      ;;
    --wineprefix)
      shift
      [ "$#" -gt 0 ] || err "--wineprefix requires a path"
      WINEPREFIX="$1"
      shift
      ;;
    --torch-dir)
      shift
      [ "$#" -gt 0 ] || err "--torch-dir requires a path"
      TORCH_DIR="$1"
      shift
      ;;
    --instances-dir)
      shift
      [ "$#" -gt 0 ] || err "--instances-dir requires a path"
      INSTANCES_DIR="$1"
      shift
      ;;
    --torch-exe)
      shift
      [ "$#" -gt 0 ] || err "--torch-exe requires a path"
      TORCH_EXE="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      TORCH_ARGS=("$@")
      break
      ;;
    *)
      err "Unknown option: $1"
      ;;
  esac
done

if [ "$RUN" -ne 1 ]; then
  usage
  exit 1
fi

prompt_backend_selection
if [ "$BACKEND" = "auto" ]; then
  BACKEND="distrobox"
fi

reexec_inside_distrobox_if_needed
ensure_torch_storage_writable
ensure_linux_dependencies
download_torch_if_needed
if [ "$BACKEND" = "distrobox" ]; then
  run_torch_with_distrobox "${TORCH_ARGS[@]}"
else
  ensure_winetricks_dependencies
  ensure_wine_windows_version
  ensure_wine_graphics_compatibility
  run_torch_with_wine "${TORCH_ARGS[@]}"
fi
