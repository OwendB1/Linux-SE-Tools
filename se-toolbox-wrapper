#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

APP_NAME="linux-se-toolbox-wrapper"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETOOLBOX_DIR="$SCRIPT_DIR/setoolbox"
SETOOLBOX_RELEASE_API_URL="https://api.github.com/repos/mmusu3/SEToolbox/releases/latest"
SETOOLBOX_ZIP_URL_FALLBACK="https://github.com/mmusu3/SEToolbox/releases/latest/download/SEToolbox.zip"
SETOOLBOX_ZIP_PATH="$SCRIPT_DIR/setoolbox.zip"
WINEPREFIX_DEFAULT="$SCRIPT_DIR/.wine-torch"
BACKEND_DEFAULT="auto"
DISTROBOX_NAME_DEFAULT="linux-se-toolbox-wrapper"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [--run] [--backend <auto|wine|distrobox>] [--install-new] [--wineprefix <path>] [--setoolbox-dir <path>] [--setoolbox-exe <path>] [--steam-install-dir <path>] [-- <setoolbox args>]

Options:
  --run                  Check/install dependencies, bootstrap SEToolbox if missing, then run via Wine.
  --backend <mode>       Runtime backend: auto (default), wine, distrobox.
  --install-new          Force download/extract into a new instance directory under <setoolbox-dir>/instances.
  --wineprefix <path>    Wine prefix path (default: $WINEPREFIX_DEFAULT)
  --setoolbox-dir <path> SEToolbox install directory (default: $SETOOLBOX_DIR)
  --setoolbox-exe <path> Explicit path to SEToolbox executable.
  --steam-install-dir <path>
                         Host Steam install directory to link into prefix
                         (auto-detected by default).
  -h, --help             Show help.

Examples:
  ./$(basename "$0") --run
  ./$(basename "$0") --run -- --help
USAGE
}

log() { printf '[%s] %s\n' "$APP_NAME" "$*"; }
err() { printf '[%s] error: %s\n' "$APP_NAME" "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

run_privileged() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    "$@"
  elif have sudo; then
    sudo "$@"
  else
    err "Need root or sudo for dependency install: $*"
  fi
}

detect_pm() {
  if have apt-get; then echo apt; return; fi
  if have dnf; then echo dnf; return; fi
  if have yum; then echo yum; return; fi
  if have pacman; then echo pacman; return; fi
  if have zypper; then echo zypper; return; fi
  echo ""
}

install_linux_dependencies() {
  local pm="$1"
  log "Installing dependencies with $pm"
  case "$pm" in
    apt)
      run_privileged dpkg --add-architecture i386
      run_privileged apt-get update
      run_privileged apt-get install -y wine64 wine32 winetricks curl unzip cabextract
      ;;
    dnf)
      run_privileged dnf install -y wine winetricks curl unzip cabextract
      ;;
    yum)
      run_privileged yum install -y wine winetricks curl unzip cabextract
      ;;
    pacman)
      run_privileged pacman -Sy --noconfirm wine winetricks curl unzip cabextract
      ;;
    zypper)
      run_privileged zypper --non-interactive install wine winetricks curl unzip cabextract
      ;;
    *)
      err "Unsupported package manager. Install wine, winetricks, curl, unzip, cabextract manually."
      ;;
  esac
}

is_immutable_os() {
  if [ -f /run/ostree-booted ]; then
    return 0
  fi

  if [ -f /run/.containerenv ]; then
    return 1
  fi

  if have rpm-ostree; then
    return 0
  fi

  if have transactional-update; then
    return 0
  fi

  local os_release_file=""
  if [ -r /etc/os-release ]; then
    os_release_file="/etc/os-release"
  elif [ -r /usr/lib/os-release ]; then
    os_release_file="/usr/lib/os-release"
  fi

  if [ -n "$os_release_file" ]; then
    if grep -Eiq '(silverblue|kinoite|sericea|onyx|coreos|microos|aeon|atomic|immutable|ostree|bootc|bazzite|bluefin|aurora|ublue|ucore)' "$os_release_file"; then
      return 0
    fi

    local os_release_tokens
    os_release_tokens="$(
      sed -nE "s/^(ID|ID_LIKE|VARIANT|VARIANT_ID|IMAGE_ID|NAME|PRETTY_NAME)=[\"']?([^\"']+)[\"']?/\2/p" "$os_release_file" \
      | tr '[:upper:]' '[:lower:]' \
      | tr ' -' '\n'
    )"
    if printf '%s\n' "$os_release_tokens" | grep -Eq '(atomic|immutable|ostree|bootc|silverblue|kinoite|sericea|onyx|coreos|microos|aeon|bazzite|bluefin|aurora|ublue|ucore)'; then
      return 0
    fi
  fi

  return 1
}

select_backend_for_auto() {
  if is_immutable_os; then
    printf '[%s] %s\n' "$APP_NAME" "Detected immutable OS; defaulting backend to distrobox." >&2
    printf 'distrobox\n'
    return
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    log "Choose runtime backend:"
    printf '  1) wine (run directly on the current system)\n' >&2
    printf '  2) distrobox (run inside a distrobox container)\n' >&2

    local choice
    while true; do
      printf 'Select backend [1-2, default 1]: ' >&2
      IFS= read -r choice || break
      case "$choice" in
        ""|1|wine)
          printf 'wine\n'
          return
          ;;
        2|distrobox)
          printf 'distrobox\n'
          return
          ;;
        *)
          printf 'Invalid selection. Enter 1 or 2.\n' >&2
          ;;
      esac
    done
  fi

  printf '[%s] %s\n' "$APP_NAME" "Non-interactive auto mode; defaulting backend to wine." >&2
  printf 'wine\n'
}

ensure_linux_dependencies() {
  local missing=0
  local cmd
  for cmd in wine winetricks curl unzip; do
    if ! have "$cmd"; then
      missing=1
      break
    fi
  done

  if [ "$missing" -eq 1 ]; then
    if is_immutable_os; then
      err "Missing Linux dependencies on an immutable OS. Use --backend distrobox to run SEToolbox in a container."
    fi
    install_linux_dependencies "$(detect_pm)"
  else
    log "Linux dependencies already installed."
  fi
}

ensure_winetricks_dependencies() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  local marker="$WINEPREFIX/.torch-wrapper-winetricks-done"
  if [ -f "$marker" ]; then
    log "Winetricks bootstrap already completed for this prefix."
    return
  fi

  log "Initializing Wine prefix"
  wineboot -u

  log "Bootstrapping Winetricks dependencies in $WINEPREFIX"
  winetricks -q corefonts vcrun2022 dotnet48
  touch "$marker"
}

ensure_wine_windows_version() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  log "Setting Wine Windows version override for SteamCMD to Windows 10"
  wine reg add "HKCU\\Software\\Wine\\Version" /v Version /t REG_SZ /d win10 /f >/dev/null
  wine reg add "HKCU\\Software\\Wine\\AppDefaults\\steamcmd.exe" /v Version /t REG_SZ /d win10 /f >/dev/null
}

apply_wine_gdi_patch() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  # Some Wine setups render WinForms/WPF context menus as solid black rectangles.
  # For SEToolbox, forcing Wine's Direct3D renderer to GDI is more stable than OpenGL/Vulkan.
  log "Applying Wine graphics patch: Direct3D renderer = gdi"
  wine reg add "HKCU\\Software\\Wine\\Direct3D" /v renderer /t REG_SZ /d gdi /f >/dev/null
}

resolve_steam_install_dir_optional() {
  if [ -n "$STEAM_INSTALL_DIR" ]; then
    if [ -d "$STEAM_INSTALL_DIR/steamapps" ]; then
      printf '%s\n' "$STEAM_INSTALL_DIR"
      return
    fi
    err "--steam-install-dir must contain a steamapps directory: $STEAM_INSTALL_DIR"
  fi

  local -a candidates=(
    "$HOME/.steam/steam"
    "$HOME/.local/share/Steam"
    "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"
  )

  local candidate
  for candidate in "${candidates[@]}"; do
    if [ -d "$candidate/steamapps" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}

link_steamapps_common_into_prefix() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  local steamapps_dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam/steamapps"
  mkdir -p "$steamapps_dir"

  local steam_dir
  steam_dir="$(resolve_steam_install_dir_optional || true)"
  if [ -z "$steam_dir" ]; then
    log "No Steam install detected on host; leaving prefix Steam steamapps directory local at $steamapps_dir"
    return
  fi

  local source_common="$steam_dir/steamapps/common"
  local target_common="$steamapps_dir/common"
  if [ ! -d "$source_common" ]; then
    log "Host Steam common directory not found at $source_common; leaving prefix Steam steamapps directory local."
    return
  fi

  if [ -L "$target_common" ]; then
    local current_target
    current_target="$(readlink "$target_common")"
    if [ "$current_target" = "$source_common" ]; then
      log "Steam common link already configured in prefix: $target_common -> $source_common"
      return
    fi
    rm -f "$target_common"
  elif [ -e "$target_common" ]; then
    local backup_path="$target_common.wrapper-backup-$(date +%Y%m%d-%H%M%S)"
    mv "$target_common" "$backup_path"
    log "Existing prefix Steam common directory moved to $backup_path"
  fi

  ln -s "$source_common" "$target_common"
  log "Linked host Steam common directory into Wine prefix: $target_common -> $source_common"
}

link_spaceengineers_compatdata_into_prefix() {
  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"

  local steam_dir
  steam_dir="$(resolve_steam_install_dir_optional || true)"
  if [ -z "$steam_dir" ]; then
    log "No Steam install detected on host; skipping Space Engineers compatdata link."
    return
  fi

  local steam_app_id="${STEAM_APP_ID:-244850}"
  local compatdata_source="$steam_dir/steamapps/compatdata/$steam_app_id/pfx/drive_c/users/steamuser/AppData/Roaming/SpaceEngineers"
  if [ ! -d "$compatdata_source" ]; then
    log "No Space Engineers compatdata directory found at $compatdata_source; skipping compatdata link."
    return
  fi

  local users_root="$WINEPREFIX/drive_c/users"
  if [ ! -d "$users_root" ]; then
    log "Wine prefix users directory not found at $users_root; skipping compatdata link."
    return
  fi

  local profile_dir
  local linked_any=0
  for profile_dir in "$users_root"/*; do
    [ -d "$profile_dir" ] || continue

    local profile_name
    profile_name="$(basename "$profile_dir")"
    case "$profile_name" in
      Public|Default|Default\ User|All\ Users)
        continue
        ;;
    esac

    local target="$profile_dir/AppData/Roaming/SpaceEngineers"
    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
      local current_target
      current_target="$(readlink "$target")"
      if [ "$current_target" = "$compatdata_source" ]; then
        log "Space Engineers compatdata link already configured for profile '$profile_name'."
        linked_any=1
        continue
      fi
      rm -f "$target"
    elif [ -e "$target" ]; then
      local backup_path="$target.wrapper-backup-$(date +%Y%m%d-%H%M%S)"
      mv "$target" "$backup_path"
      log "Existing Space Engineers data for profile '$profile_name' moved to $backup_path"
    fi

    ln -s "$compatdata_source" "$target"
    log "Linked Space Engineers compatdata for profile '$profile_name': $target -> $compatdata_source"
    linked_any=1
  done

  if [ "$linked_any" -eq 0 ]; then
    log "No non-system Wine user profiles found under $users_root; skipped compatdata link."
  fi
}

resolve_setoolbox_exe_optional() {
  if [ -n "$SETOOLBOX_EXE" ] && [ -f "$SETOOLBOX_EXE" ]; then
    printf '%s\n' "$SETOOLBOX_EXE"
    return
  fi

  local -a exe_candidates=()
  local candidate
  for candidate in \
    "$SETOOLBOX_DIR/SEToolbox.exe" \
    "$SETOOLBOX_DIR/setoolbox.exe" \
    "$SETOOLBOX_DIR/Toolbox.exe"; do
    if [ -f "$candidate" ]; then
      exe_candidates+=("$candidate")
    fi
  done

  if [ -d "$SETOOLBOX_DIR" ]; then
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      exe_candidates+=("$candidate")
    done < <(find "$SETOOLBOX_DIR" -maxdepth 8 -type f \( -iname 'setoolbox*.exe' -o -iname '*setoolbox*.exe' -o -iname '*space*engineer*toolbox*.exe' \) | sort -f)
  fi

  local -A seen=()
  local -a unique_candidates=()
  for candidate in "${exe_candidates[@]}"; do
    local basename_lower
    basename_lower="$(basename "$candidate" | tr '[:upper:]' '[:lower:]')"

    # Ignore updater/helper binaries when resolving the main launch target.
    case "$basename_lower" in
      setoolboxupdate.exe|setoolbox-updater.exe|setoolboxupdater.exe)
        continue
        ;;
    esac

    if [ -z "${seen[$candidate]+x}" ]; then
      seen["$candidate"]=1
      unique_candidates+=("$candidate")
    fi
  done

  local total="${#unique_candidates[@]}"
  if [ "$total" -eq 0 ]; then
    return
  fi

  if [ "$total" -eq 1 ]; then
    printf '%s\n' "${unique_candidates[0]}"
    return
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    printf '[%s] %s\n' "$APP_NAME" "Multiple SEToolbox binaries detected. Select one to run:" >&2
    local i
    for i in "${!unique_candidates[@]}"; do
      printf '  %d) %s\n' "$((i + 1))" "${unique_candidates[$i]}" >&2
    done

    local choice
    while true; do
      printf 'Enter selection [1-%d]: ' "$total" >&2
      IFS= read -r choice || break
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
        printf '%s\n' "${unique_candidates[$((choice - 1))]}"
        return
      fi
      printf 'Invalid selection. Please choose a number between 1 and %d.\n' "$total" >&2
    done
  fi

  printf '[%s] %s\n' "$APP_NAME" "Multiple SEToolbox binaries detected in non-interactive mode; defaulting to: ${unique_candidates[0]}" >&2
  printf '%s\n' "${unique_candidates[0]}"
}

download_setoolbox() {
  local target_dir="$1"
  local setoolbox_zip_url
  setoolbox_zip_url="$(resolve_setoolbox_zip_url)"

  log "Downloading latest SEToolbox build from $setoolbox_zip_url"
  rm -f "$SETOOLBOX_ZIP_PATH"
  curl -fL --retry 3 --retry-delay 2 -o "$SETOOLBOX_ZIP_PATH" "$setoolbox_zip_url"

  mkdir -p "$target_dir"
  unzip -oq "$SETOOLBOX_ZIP_PATH" -d "$target_dir"
  log "SEToolbox extracted to $target_dir"
}

resolve_setoolbox_zip_url() {
  local latest_release_json
  local zip_asset_url
  local -a github_api_headers=(
    -H "Accept: application/vnd.github+json"
    -H "User-Agent: $APP_NAME"
    -H "X-GitHub-Api-Version: 2022-11-28"
  )

  printf "[%s] %s\n" "$APP_NAME" "Resolving latest SEToolbox zip asset via release API" >&2
  latest_release_json="$(curl -fsSL --retry 3 --retry-delay 2 "${github_api_headers[@]}" "$SETOOLBOX_RELEASE_API_URL" || true)"
  if [ -n "$latest_release_json" ]; then
    zip_asset_url="$(
      printf '%s\n' "$latest_release_json" \
      | sed 's#\\/#/#g' \
      | sed -nE 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' \
      | grep -E '/SEToolbox-[0-9][^/]*\.zip$' \
      | head -n1 || true
    )"
    if [ -n "$zip_asset_url" ]; then
      printf '%s\n' "$zip_asset_url"
      return
    fi
  fi

  printf "[%s] %s\n" "$APP_NAME" "Could not find a SEToolbox-*.zip asset in latest release metadata; falling back to $SETOOLBOX_ZIP_URL_FALLBACK" >&2
  printf '%s\n' "$SETOOLBOX_ZIP_URL_FALLBACK"
}

download_setoolbox_if_needed() {
  local exe
  exe="$(resolve_setoolbox_exe_optional || true)"
  if [ "$INSTALL_NEW" -eq 0 ] && [ -n "$exe" ]; then
    log "Detected existing SEToolbox executable at $exe; skipping download."
    return
  fi

  if [ "$INSTALL_NEW" -eq 1 ]; then
    local instance_dir
    instance_dir="$SETOOLBOX_DIR/instances/setoolbox-$(date +%Y%m%d-%H%M%S)"
    download_setoolbox "$instance_dir"
    SETOOLBOX_EXE="$(resolve_setoolbox_exe_optional || true)"
    [ -n "$SETOOLBOX_EXE" ] || err "SEToolbox download completed but no executable was found in $instance_dir"
    return
  fi

  download_setoolbox "$SETOOLBOX_DIR"
}

resolve_setoolbox_exe_required() {
  local exe
  exe="$(resolve_setoolbox_exe_optional || true)"
  [ -n "$exe" ] || err "Unable to locate SEToolbox executable in $SETOOLBOX_DIR"
  printf '%s\n' "$exe"
}

run_setoolbox() {
  local exe
  exe="$(resolve_setoolbox_exe_required)"
  local exe_dir
  exe_dir="$(cd "$(dirname "$exe")" && pwd)"
  local steam_app_id="${STEAM_APP_ID:-244850}"

  export WINEPREFIX="$WINEPREFIX"
  mkdir -p "$WINEPREFIX"
  export SteamAppId="$steam_app_id"
  export SteamGameId="$steam_app_id"

  log "Launching SEToolbox via Wine: $exe"
  log "Steam environment: SteamAppId=$SteamAppId SteamGameId=$SteamGameId"
  log "Launching from executable directory: $exe_dir"
  (
    cd "$exe_dir"
    wine "$exe" "$@"
  )
}

run_inside_distrobox() {
  local -a forward_args=("$@")
  local distrobox_name="${DISTROBOX_NAME:-$DISTROBOX_NAME_DEFAULT}"
  local launch_cwd="${LAUNCH_CWD:-$PWD}"

  have distrobox || err "distrobox backend selected but 'distrobox' is not installed."
  have distrobox-enter || err "distrobox backend selected but 'distrobox-enter' is not installed."

  log "Preparing distrobox container '$distrobox_name' with home '$launch_cwd'"
  distrobox create --yes --name "$distrobox_name" --image quay.io/toolbx/ubuntu-toolbox:latest --home "$launch_cwd"

  log "Entering distrobox '$distrobox_name' and reinvoking wrapper"
  distrobox-enter --name "$distrobox_name" -- "$0" "${forward_args[@]}"
}

RUN=0
INSTALL_NEW=0
WINEPREFIX="$WINEPREFIX_DEFAULT"
SETOOLBOX_EXE=""
STEAM_INSTALL_DIR=""
SETOOLBOX_ARGS=()
BACKEND="$BACKEND_DEFAULT"
BACKEND_SET=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --run)
      RUN=1
      shift
      ;;
    --install-new)
      INSTALL_NEW=1
      shift
      ;;
    --backend)
      shift
      [ "$#" -gt 0 ] || err "--backend requires one of: auto, wine, distrobox"
      BACKEND="$1"
      BACKEND_SET=1
      shift
      ;;
    --wineprefix)
      shift
      [ "$#" -gt 0 ] || err "--wineprefix requires a path"
      WINEPREFIX="$1"
      shift
      ;;
    --setoolbox-dir)
      shift
      [ "$#" -gt 0 ] || err "--setoolbox-dir requires a path"
      SETOOLBOX_DIR="$1"
      shift
      ;;
    --setoolbox-exe)
      shift
      [ "$#" -gt 0 ] || err "--setoolbox-exe requires a path"
      SETOOLBOX_EXE="$1"
      shift
      ;;
    --steam-install-dir)
      shift
      [ "$#" -gt 0 ] || err "--steam-install-dir requires a path"
      STEAM_INSTALL_DIR="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      SETOOLBOX_ARGS=("$@")
      break
      ;;
    *)
      err "Unknown option: $1"
      ;;
  esac
done

if [ "$RUN" -ne 1 ]; then
  usage
  exit 1
fi

case "$BACKEND" in
  auto|wine|distrobox)
    ;;
  *)
    err "Invalid --backend '$BACKEND'. Valid values: auto, wine, distrobox"
    ;;
esac

if [ "$BACKEND" = "auto" ]; then
  BACKEND="$(select_backend_for_auto)"
fi

if [ "$BACKEND_SET" -eq 0 ] && [ "$BACKEND" = "wine" ] && is_immutable_os && have distrobox && have distrobox-enter; then
  log "Immutable OS detected with distrobox available; switching backend to distrobox to avoid host package installation."
  BACKEND="distrobox"
fi

if [ "$BACKEND" = "distrobox" ]; then
  RERUN_ARGS=(--run --backend wine --wineprefix "$WINEPREFIX" --setoolbox-dir "$SETOOLBOX_DIR")
  if [ "$INSTALL_NEW" -eq 1 ]; then
    RERUN_ARGS+=(--install-new)
  fi
  if [ -n "$SETOOLBOX_EXE" ]; then
    RERUN_ARGS+=(--setoolbox-exe "$SETOOLBOX_EXE")
  fi
  if [ -n "$STEAM_INSTALL_DIR" ]; then
    RERUN_ARGS+=(--steam-install-dir "$STEAM_INSTALL_DIR")
  fi
  if [ "${#SETOOLBOX_ARGS[@]}" -gt 0 ]; then
    RERUN_ARGS+=(-- "${SETOOLBOX_ARGS[@]}")
  fi
  run_inside_distrobox "${RERUN_ARGS[@]}"
  exit 0
fi

ensure_linux_dependencies
download_setoolbox_if_needed
ensure_winetricks_dependencies
ensure_wine_windows_version
apply_wine_gdi_patch
link_steamapps_common_into_prefix
link_spaceengineers_compatdata_into_prefix
run_setoolbox "${SETOOLBOX_ARGS[@]}"
